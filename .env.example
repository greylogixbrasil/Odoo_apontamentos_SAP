# Copie para .env e preencha. Nunca commitar .env com valores reais.

POSTGRES_DSN=postgresql://sap_import:sap_import@localhost:55432/sap_import

# Login HTTP Basic exigido em toda a API/painel (ver app_acompanhamento/auth.py).
APP_AUTH_USER=
APP_AUTH_PASSWORD=

# Essa aplicacao (ApontaSAP) so opera contra producao.
SAP_ENV=prod

SAP_PROD_BASE_URL=https://greylogix-sl.skyinone.net:50000/b1s/v1
SAP_PROD_COMPANY_DB=SBO_GREYLOGIX_PRD
SAP_PROD_USERNAME=manager
SAP_PROD_PASSWORD=

# Tamanho do lote de envio e pausa entre lotes (segundos)
BATCH_SIZE=50
BATCH_SLEEP_SECONDS=2

# Tolerancia de horas na checagem de idempotencia contra o SAP
TOLERANCIA_HORAS=0.01

# Enviar linhas com horas = 0 (folga/reuniao sem duracao)? false = pula e loga
ENVIAR_LINHAS_ZERO_HORA=false

# HANA direto - usado SOMENTE para leitura/validacao (reconciliacao contra o que ja existe no SAP).
# O envio (POST) continua sempre via Service Layer (src/sap_client.py), nunca por aqui.
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA_PROD=SBO_GREYLOGIX_PRD
# Validacao de certificado TLS na conexao HANA - default false (comportamento historico).
# So habilite true se o certificado do servidor HANA for confiavel pela cadeia de CA do
# container/host (senao a conexao passa a falhar).
HANA_SSL_VALIDATE_CERTIFICATE=false

# Odoo (XML-RPC, somente leitura) - fonte dos apontamentos.
ODOO_URL=https://greylogix.odoo.com
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# Webhook opcional (formato Slack/Teams incoming webhook: {"text": ...}) pra notificar falha
# no envio diario automatico ou no "rodar agora". Deixe vazio pra so logar (app_log/Postgres).
ALERTA_WEBHOOK_URL=

# Tempo nao alocado (tela /nao-alocado, src/nao_alocado.py). ActivityType (IdSAP, tabela PMC6 do
# SAP) usado no lancamento - vazio = ainda nao definido, so o preview funciona (candidato: 27 -
# "Sem alocacao em projeto"). O envio tambem exige liberar explicitamente a trava abaixo.
NAO_ALOCADO_IDSAP=
NAO_ALOCADO_ENVIO_HABILITADO=false
